{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "title":"Defensive threat mitigations",
  "additionalProperties":false,
  "required":["schema_version","kind","reviewed_on","records"],
  "properties":{
    "schema_version":{"const":1},
    "kind":{"const":"defensive-threat-mitigations"},
    "reviewed_on":{"type":"string","format":"date"},
    "records":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","category","assessment","mitigation","source"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},
        "category":{"type":"string","minLength":1},
        "assessment":{"enum":["local_update_review","local_index_review","local_lifecycle_review","manual_review"]},
        "mitigation":{"type":"string","minLength":1},
        "source":{"type":"string","format":"uri"}
      }
    }}
  }
}
